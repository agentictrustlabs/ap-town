{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true, "noEmit": true, "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true, "types": ["@cloudflare/workers-types"], "lib": ["ES2022"]
  },
  "include": ["src/**/*", "test/**/*"]
}
