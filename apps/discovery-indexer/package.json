{
  "name": "@ap-town/discovery-indexer",
  "version": "0.0.1-alpha.16",
  "private": true,
  "description": "Discovery indexer (demo-discovery-indexer): enumerates every Smart Agent in agent-naming and projects available on-chain facets into the discovery A-box (GraphDB @ agentkg.io), then loads the agentic-trust ontology so the KB self-describes. Demo-grade reference; a production agent-indexer graduates to an external repo (ADR-0037) when packages publish.",
  "type": "module",
  "scripts": {
    "index": "tsx src/main.ts",
    "load-ontology": "tsx src/load-ontology.ts",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "deploy:faithnet": "wrangler deploy --env faithnet",
    "index:faithnet": "CHAIN_ID=34348 TLDS=me,org,team,svc,workspace,treasury,registry,church,circle DISCOVERY_REGISTRY_ID=urn:ap:registry:faithnet-agents NAME_REGISTRY=0x9BE6c96F198a7EDaE0Bb80c98A68EB76Cb85a4bC RESOLVER=0x56B6FBe849356a1D89d024DcA8abf74BF828bF4f NAME_RESOLVER=0x27e993A42E055C52F8fa193883e4fBE08941bE4A PROFILE_RESOLVER=0xc86d67D5ef2ed185e26a5f97f63e506CdA4e45C1 RELATIONSHIP=0xa5556Adc4202c1d2dC826a66dBCDad3c50E11BB5 ATTESTATION_REGISTRY=0xE135d506b9A9B62e0B5D4F682212c7224aa6566F REGISTRY= tsx src/main.ts",
    "load-ontology:faithnet": "tsx src/load-ontology.ts",
    "rebuild-custody": "tsx scripts/rebuild-custody.ts"
  },
  "dependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.50",
    "@agenticprimitives/agent-naming": "1.0.0-alpha.48",
    "@agenticprimitives/capability-claims": "0.0.0-alpha.48",
    "@agenticprimitives/content-primitives": "1.0.0-alpha.42",
    "@agenticprimitives/content-storage": "1.0.0-alpha.21",
    "@agenticprimitives/delegation": "1.0.0-alpha.48",
    "@agenticprimitives/ontology": "1.0.0-alpha.48",
    "@agenticprimitives/registry-kit": "0.0.0-alpha.29",
    "@agenticprimitives/types": "1.0.0-alpha.48",
    "@agenticprimitives/verifiable-credentials": "0.0.0-alpha.45",
    "@ap-town/town-model": "workspace:*",
    "hono": "4.13.0",
    "viem": "2.52.2"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "4.1.8",
    "wrangler": "4.93.0"
  }
}
