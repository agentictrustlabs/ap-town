{
  "name": "ap-town",
  "version": "0.0.0",
  "private": true,
  "description": "ap-town \u2014 the services every estate on one chain shares: naming, the registry, the public graph and discovery, chain access, the Town portal (spec 429). A product repository on published @agenticprimitives/* packages (ADR-0063).",
  "type": "module",
  "engines": {
    "node": ">=22.18",
    "pnpm": ">=9"
  },
  "scripts": {
    "doctor": "ap doctor",
    "doctor:rules": "ap doctor --rules",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "check": "pnpm typecheck && pnpm test && pnpm check:town && pnpm gen:town --check && pnpm check:no-estate-binding && pnpm check:no-vector-over-vault && pnpm check:no-jsx-escapes && ap doctor && pnpm check:public-links",
    "conform:a2a": "ap conform a2a",
    "conform:mcp": "ap conform mcp",
    "upgrade:canary": "ap upgrade --canary",
    "upgrade:pin": "ap upgrade --pin",
    "check:no-vector-over-vault": "tsx checks/check-no-vector-over-vault.ts",
    "check:no-jsx-escapes": "tsx checks/check-no-jsx-escapes.ts",
    "check:public-links": "node scripts/check-public-links.mjs",
    "check:town": "tsx checks/check-town-manifest.ts",
    "check:no-estate-binding": "tsx checks/check-no-estate-binding.ts",
    "probe:town": "tsx checks/probe-town.ts",
    "gen:town": "tsx checks/gen-town.ts",
    "provision:naming": "tsx scripts/provision-naming-service.mts",
    "card:release": "pnpm --filter @ap-town/town-agent exec tsx scripts/release-card.mts",
    "gate:card-signature": "pnpm --filter @ap-town/town-agent exec tsx scripts/gate-card-signature.mts"
  },
  "devDependencies": {
    "@agenticprimitives/a2a": "0.0.0-alpha.33",
    "@agenticprimitives/devkit": "0.0.0-alpha.18",
    "@agenticprimitives/evaluation": "0.0.0-alpha.5",
    "@agenticprimitives/mcp-protocol": "0.0.0-alpha.4",
    "typescript": "^5.7.3",
    "vitest": "^4.1.8",
    "tsx": "^4.22.4",
    "@types/node": "^22.7.0",
    "@agenticprimitives/audit": "1.0.0-alpha.32",
    "@agenticprimitives/connect-auth": "1.0.0-alpha.32",
    "@agenticprimitives/key-custody": "1.0.0-alpha.32",
    "@agenticprimitives/ontology": "1.0.0-alpha.32",
    "@agenticprimitives/agent-account": "1.0.0-alpha.32",
    "@agenticprimitives/agent-naming": "1.0.0-alpha.32",
    "@agenticprimitives/contracts": "1.0.0-alpha.32",
    "@agenticprimitives/delegation": "1.0.0-alpha.32",
    "viem": "2.52.2",
    "@agenticprimitives/types": "1.0.0-alpha.32"
  },
  "pnpm": {
    "overrides": {
      "typescript": "~5.7.0",
      "@types/react": "^19.2.16",
      "@types/react-dom": "^19.2.3",
      "esbuild": "^0.28.1",
      "undici": ">=8.10.2",
      "fast-uri": ">=4.1.3",
      "brace-expansion": ">=5.0.11",
      "ws": ">=8.21.0",
      "postcss": ">=8.5.18",
      "js-yaml": ">=4.3.0",
      "form-data": ">=4.0.6",
      "axios": ">=1.20.0",
      "ip-address": ">=10.3.1",
      "socket.io-parser": ">=4.2.7",
      "sharp": ">=0.35.4",
      "read-yaml-file>js-yaml": "^3.15.2",
      "nanoid@3": "^3.3.18"
    }
  },
  "packageManager": "pnpm@9.15.0"
}
