{
  "name": "@ap-town/town-ui",
  "version": "0.0.1",
  "private": true,
  "description": "What the town's web apps share: a History-API router with real links, a fetch hook, and a few plain pieces (chips, banners, loading). No data, no authority.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./base.css": "./src/base.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.2.16",
    "react": "19.2.7",
    "typescript": "5.7.3",
    "vitest": "4.1.8"
  }
}
